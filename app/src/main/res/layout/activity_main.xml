<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stark_hud_bg"
    android:padding="16dp">

    <!-- Top Stark Telemetry Header -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STARK INDUSTRIES"
                android:textColor="#8000E5FF"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="J.A.R.V.I.S."
                android:textColor="#00F0FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/stark_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="● ONLINE"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_hands_free_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/stark_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="🎤 WAKE: ARMED"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#81D4FA" />
    </LinearLayout>

    <!-- Permission & Notification Access Alert Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_permission_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#2600E5FF"
        app:strokeColor="#00E5FF"
        app:strokeWidth="1.5dp"
        app:cardCornerRadius="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_perm_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Notification Access Offline: Tap Enable to authorize in Settings"
                android:textColor="#E1F5FE"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fix_perms"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Enable"
                android:textSize="11sp"
                android:fontFamily="monospace"
                app:backgroundTint="#00E5FF"
                android:textColor="#000000" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Center Stark Arc Reactor Hologram -->
    <FrameLayout
        android:id="@+id/core_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/card_permission_alert"
        app:layout_constraintBottom_toTopOf="@id/layout_waveform"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Atmospheric Radial Halo -->
        <View
            android:id="@+id/view_core_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/neural_core_glow" />

        <!-- Segmented Holographic Outer Ring -->
        <View
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:background="@drawable/arc_reactor_ring" />

        <!-- Middle Containment Arc -->
        <View
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center"
            android:background="@drawable/floating_orb" />

        <!-- Center Vibranium Plasma Core -->
        <View
            android:id="@+id/view_core_pulse"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/arc_reactor_plasma" />

        <!-- Holographic Core Callout -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ARC"
            android:textColor="#020817"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Dynamic Audio Waveform Equalizer -->
    <LinearLayout
        android:id="@+id/layout_waveform"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/core_container"
        app:layout_constraintBottom_toTopOf="@id/tv_core_state"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/view_eq_1"
            android:layout_width="4dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="2dp"
            android:background="#00E5FF" />
        <View
            android:id="@+id/view_eq_2"
            android:layout_width="4dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="2dp"
            android:background="#00E5FF" />
        <View
            android:id="@+id/view_eq_3"
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="2dp"
            android:background="#00F0FF" />
        <View
            android:id="@+id/view_eq_4"
            android:layout_width="4dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="2dp"
            android:background="#00E5FF" />
        <View
            android:id="@+id/view_eq_5"
            android:layout_width="4dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="2dp"
            android:background="#00E5FF" />
    </LinearLayout>

    <!-- State & Subtitle -->
    <TextView
        android:id="@+id/tv_core_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ STANDBY // SAY 'HEY JARVIS' ]"
        android:textColor="#81D4FA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/layout_waveform"
        app:layout_constraintBottom_toTopOf="@id/scroll_protocols_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stark Protocols & System Control Ribbon -->
    <HorizontalScrollView
        android:id="@+id/scroll_protocols_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_core_state"
        app:layout_constraintBottom_toTopOf="@id/dialogue_container">

        <LinearLayout
            android:id="@+id/scroll_protocols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/chip_house_party"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="⚡ HOUSE PARTY"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_clean_slate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🧹 CLEAN SLATE"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_sentry_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🛡️ SENTRY MODE"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_protocol_11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🔴 PROTOCOL 11"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_smart_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="📺 SMART TV"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="📊 TELEMETRY"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_calibrate_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🎯 TRAIN WAKE"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/chip_voice_tts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/stark_chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🎙️ BRITISH VOICE"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Holographic Conversation HUD Terminal -->
    <ScrollView
        android:id="@+id/dialogue_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/stark_card_bg"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_protocols_container"
        app:layout_constraintBottom_toTopOf="@id/bottom_input_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// TACTICAL TELEMETRY STREAM"
                android:textColor="#5900E5FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jarvis: Standing by, Sir. Arc reactor online and listening across local perimeter."
                android:textColor="#E1F5FE"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Input & Tactical Controls Capsule -->
    <LinearLayout
        android:id="@+id/bottom_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#1A0A1935"
            app:boxStrokeColor="#00E5FF"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:hintTextColor="#00E5FF"
            android:textColorHint="#81D4FA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Command Jarvis or trigger protocol..."
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:imeOptions="actionSend"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_vision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:srcCompat="@android:drawable/ic_menu_camera"
            app:backgroundTint="#00E5FF"
            app:tint="#000000"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:srcCompat="@android:drawable/ic_btn_speak_now"
            app:backgroundTint="#00E5FF"
            app:tint="#000000"
            app:fabSize="mini" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
