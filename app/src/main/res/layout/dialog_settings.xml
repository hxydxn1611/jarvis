<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F1424"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3300E5FF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUPER-INTELLIGENCE CORE"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paste your free Gemini API Key from Google AI Studio (aistudio.google.com) to unlock hyper-intelligent reasoning and screen vision."
        android:textColor="#81D4FA"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="#00E5FF"
        app:hintTextColor="#00E5FF"
        android:textColorHint="#81D4FA">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API Key (AIzaSy...)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ACTIVATE SUPER-BRAIN"
        android:textColor="#000000"
        android:textStyle="bold"
        app:backgroundTint="#00E5FF" />

    <!-- Permission Links inside settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYSTEM DIAGNOSTICS"
        android:textColor="#81D4FA"
        android:textSize="12sp"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_access"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Accessibility"
            android:textColor="#00E5FF"
            app:strokeColor="#00E5FF"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_overlay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Floating Orb"
            android:textColor="#00E5FF"
            app:strokeColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
